        }
    },
    "processing": {
        "early_tool_prep": false,
        "f_for_rapid_moves": false,
        "filter_inefficient_moves": false,
        "split_arcs": false,
        "tool_change": true,
        "translate_drill_cycles": false,
        "translate_rapid_moves": false,
        "xy_before_z_after_tool_change": true
    },
    "version": 1
