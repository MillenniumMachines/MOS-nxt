        "description": "Milo V1.5 desktop mill, moving table in X and Y, Duet + RepRapFirmware with nxt Fitted with the Spit Roast 4th axis (A, about X).",
        "kinematics": {
            "base_frame": {
                "orientation_quaternion": [
                    0,
                    0,
                    0,
                    1.0
                ],
                "origin": [
                    0,
                    0,
                    0
                ]
            },
            "dwo_supported": true,
            "notes": "Rotary variant: Spit Roast 4th axis (A, about X) on a Milo V1.5. A-axis figures are the MosFourthAxis plugin defaults from rotary-plugin-config.g (M208 A+/-3600, M203 A45000, M201 A300, M92 A177.7919) - replace them with your own if you have recalibrated. Indexed (3+1) positioning only: the post emits G0 A<angle> and the path already rotated into the machine frame. Continuous/simultaneous 4-axis is NOT supported - it needs inverse-time feed (G93), which FreeCAD's post pipeline does not emit. Work zero must sit on the rotary centreline (probe it with M4910) because nothing applies a pivot offset.",
            "rotation_strategy": "dwo",
            "tcp_supported": false
        },
        "manufacturer": "Millennium Machines",
        "name": "Milo V1.5 + Rotary",
        "toolheads": [
            {
                "coolant_delay": 0.0,
                "coolant_flood": false,
                "coolant_mist": true,
                "id": "spindle1",
                "max_power_kw": 1.5,
                "max_rpm": 24000,
                "min_rpm": 7200,
                "name": "Spindle",
                "tool_change": "manual",
                "toolhead_type": "rotary",
                "toolhead_wait": 0.0
            }
        ],
        "units": "metric"
    },
    "output": {
        "comments": {
            "enabled": true,
            "include_blank_lines": true,
            "include_operation_labels": true,
            "output_bcnc_comments": false,
            "symbol": "("
        },
        "duplicates": {
            "commands": true,
            "parameters": false
        },
        "formatting": {
            "command_space": " ",
            "end_of_line_chars": "\n",
            "line_increment": 10,
            "line_number_prefix": "N",
            "line_number_start": 100,
            "line_numbers": false
        },
        "header": {
            "include_date": true,
            "include_description": true,
            "include_document_name": true,
            "include_fixture_list": false,
            "include_machine_name": true,
            "include_project_file": true,
            "include_tool_list": false,
            "include_units": true,
            "output_header": true
        },
        "output_tool_length_offset": false,
        "precision": {
            "axis": 4,
            "feed": 0,
            "spindle": 0
        },
        "remote_post": false,
        "units": "metric"
    },
    "postprocessor": {
        "file_name": "nxt_machine",
        "properties": {
            "allow_zero_rpm": false,
            "drill_cycles_to_translate": "",
            "file_extension": "gcode",
            "home_before_start": true,
            "nxt_version": "v0.7.0",
            "output_job_setup": true,
            "output_tools": true,
            "post_rotary_move": "",
            "postamble": "M9\nG27",
            "pre_rotary_move": "G53 G0 Z0",
            "preamble": "G90\nG94",
            "probe_mode": "ON_CHANGE",
            "safetyblock": "",
            "supports_tool_radius_compensation": false,
            "version_check": true,
            "vssc": true,
