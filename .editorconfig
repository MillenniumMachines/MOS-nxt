# https://editorconfig.org — keep LF in sync with .gitattributes
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.g]
trim_trailing_whitespace = false

[*.gcode]
trim_trailing_whitespace = false
