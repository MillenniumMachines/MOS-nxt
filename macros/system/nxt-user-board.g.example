; nxt-user-board.g — copy to 0:/sys/nxt-user-board.g
; Loaded by nxt-board-pack-loader.g when nxt-board-bootstrap.requested exists.
; Use ONE pack entry line (uncomment the path that matches your wiring).
; Board packs are shared; machine profile is separate (nxtPlatformProfile).
; RRF 3.7: Scylla only (Fly CDYv3 is not supported).

; Scylla 24 V / 48 V
; M98 P"nxt-config/board/scylla1_0_h723/motor-24v/entry.g"
; M98 P"nxt-config/board/scylla1_0_h723/motor-48v/entry.g"
