; nxt-user-overrides.g.example — shipped on SD by the nxt plugin (this file is NOT loaded).
; To enable overrides: copy this file to 0:/sys/nxt-user-overrides.g (same folder).
; nxt.g loads only nxt-user-overrides.g last before setting global.nxtLoaded
; (after board pack, boot checks, plugins, RGB). Reboot or M98 P"nxt.g" to apply.
;
; Prefer `set` for keys already in nxt-vars.g. For optional keys not in nxt-vars,
; declare with if { !exists } first (OM ~8KB budget).

; Defaults in nxt-vars.g: inner=3, max spread=0.0075 mm, outer retries=1
; set global.nxtProbeInnerSampleCount = 3
; set global.nxtProbeMaxSampleSpreadMm = 0.0075
; set global.nxtProbeSampleOuterRetries = 1
;
; Optional per-probe-type overrides (tpost.g / G6511 fall back to the generics above):
; if { !exists(global.nxtTouchProbeInnerSampleCount) }
;     global nxtTouchProbeInnerSampleCount = 3
; set global.nxtTouchProbeInnerSampleCount = 3
; if { !exists(global.nxtToolSetterInnerSampleCount) }
;     global nxtToolSetterInnerSampleCount = 3
; set global.nxtToolSetterInnerSampleCount = 3
