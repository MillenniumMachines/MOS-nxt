; nxt-user-overrides.g.example — shipped on SD by the NeXT plugin (this file is NOT loaded).
; To enable overrides: copy this file to 0:/sys/nxt-user-overrides.g (same folder).
; nxt.g loads only nxt-user-overrides.g, last in the boot sequence (after board pack, boot, plugins).
; Use set global.* lines (not global declarations). Reboot or M98 P"nxt-user-overrides.g" to apply.

; Defaults in nxt-vars.g: inner=3, max spread=0.0075 mm, outer retries=1
; set global.nxtProbeInnerSampleCount = 3
; set global.nxtProbeMaxSampleSpreadMm = 0.0075
; set global.nxtProbeSampleOuterRetries = 1
;
; Optional per-probe-type overrides used by tpost.g:
; set global.nxtTouchProbeInnerSampleCount = 3
; set global.nxtTouchProbeMaxSampleSpreadMm = 0.0075
; set global.nxtTouchProbeSampleOuterRetries = 1
; set global.nxtToolSetterInnerSampleCount = 3
; set global.nxtToolSetterMaxSampleSpreadMm = 0.0075
; set global.nxtToolSetterSampleOuterRetries = 1
